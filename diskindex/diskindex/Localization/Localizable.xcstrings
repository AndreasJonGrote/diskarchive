    "copy.settings.exclude.placeholder" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name, Endung (*.log) oder Ordner…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name, extension (*.log), or folder…"
          }
        }
      }
    },
    "copy.settings.exclude.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen, Endungen oder Ordner, die auf keinem Speichermedium indiziert werden. Lässt sich auch per Rechtsklick auf ein Objekt setzen. Bereits erfasste Treffer verschwinden sofort aus der Ansicht und werden nach 1 Stunde aus dem Index gelöscht, sofort über „Index jetzt bereinigen“ im Tab „Erweitert“. Wird ein Chip entfernt, erscheint, was noch im Index ist; der Rest kommt beim nächsten Scan dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names, extensions, or folders never indexed on any volume. Can also be set via right-click. Matches already indexed disappear from view and are removed from the index after 1 hour, or immediately via “Clean up index now” in Advanced. Removing a chip shows what remains; the rest is added on the next scan."
          }
        }
      }
    },
    "copy.settings.exclude.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATEIEN & ORDNER AUSSCHLIESSEN"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EXCLUDE FILES & FOLDERS"
          }
        }
      }
    },
    "copy.settings.hidden.ignore" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore"
          }
        }
      }
    },
    "copy.settings.hidden.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt versteckte Systemdateien und -ordner vom Index aus. Beim Einschalten verschwinden sie sofort aus der Ansicht und werden nach 1 Stunde aus dem Index gelöscht, sofort über „Index jetzt bereinigen“ (Erweitert). Beim Ausschalten erscheint, was noch im Index ist; der Rest kommt beim nächsten Scan dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excludes hidden system files and folders from the index. When enabled they disappear from view and are removed after 1 hour, or immediately via “Clean up index now” (Advanced). When disabled, what remains in the index reappears; the rest is added on the next scan."
          }
        }
      }
    },
    "copy.settings.hidden.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
