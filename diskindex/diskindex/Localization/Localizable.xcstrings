    "copy.settings.scan_depth.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Ordnerebenen unterhalb des Wurzelverzeichnisses eines Speichermediums durchsucht werden. „5+“ durchsucht uneingeschränkt alles. Wird die Tiefe verringert, verschwinden tiefere Ebenen sofort aus der Ansicht und werden nach 1 Stunde aus dem Index gelöscht, sofort über „Index jetzt bereinigen“ (Erweitert). Wird sie erhöht, erscheint, was noch im Index ist; fehlende Ebenen kommen beim nächsten Scan dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many folder levels below each volume root are scanned. “5+” scans without limit. Lowering depth hides deeper levels immediately and removes them from the index after 1 hour, or immediately via “Clean up index now” (Advanced). Raising depth shows what remains in the index; missing levels are added on the next scan."
          }
        }
      }
    },
