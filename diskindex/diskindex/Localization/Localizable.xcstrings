    "copy.settings.prune.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werden Dateien oder Ordner ausgeschlossen, unsichtbare Dateien oder Artefakte ignoriert oder die Scan-Tiefe verringert, verschwinden die betroffenen Einträge sofort aus der Ansicht, auch Favoriten darunter. Aus dem Index gelöscht werden sie nach 1 Stunde. „Index jetzt bereinigen“ löscht sie sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluded files or folders, ignored hidden files or artifacts, or reduced scan depth remove affected entries from view immediately, including favorites below. They are deleted from the index after 1 hour. “Clean up index now” deletes them immediately."
          }
        }
      }
    },
    "copy.settings.prune.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
