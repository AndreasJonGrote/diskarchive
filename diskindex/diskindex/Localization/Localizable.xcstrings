    "copy.settings.artifacts.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignoriert temporäre Dateien, Backups, Systemreste und Ordner mit generischen Programmbibliotheken. Beim Einschalten verschwinden sie sofort aus der Ansicht und werden nach 1 Stunde aus dem Index gelöscht, sofort über „Index jetzt bereinigen“ (Erweitert). Beim Ausschalten erscheint, was noch im Index ist; der Rest kommt beim nächsten Scan dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignores temporary files, backups, system clutter, and generic library folders. When enabled they disappear from view and are removed after 1 hour, or immediately via “Clean up index now” (Advanced). When disabled, what remains reappears; the rest is added on the next scan."
          }
        }
      }
    },
    "copy.settings.artifacts.title" : {
