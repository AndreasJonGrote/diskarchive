    "copy.settings.notices.system_and_pauses" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemmeldungen umfassen Hinweise zu Fehlern und zu Pausen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System messages include notes on errors and pauses."
          }
        }
      }
    },
    "copy.settings.notices.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Ereignis einzeln wählbar. Systemmeldungen umfassen Hinweise zu Fehlern und zu Pausen. „Vollständig indiziert“ erscheint nur, wenn der Scan länger als 59 Sekunden gedauert hat (auch bei einem Abgleich oder „Neu indizieren“). Ist „Mitteilungen aktivieren“ aus, sind die Ereignisse deaktiviert. Beim ersten Start fragt macOS einmalig, ob Mitteilungen erlaubt werden. Wurde das abgelehnt, lässt es sich nur in den macOS-Systemeinstellungen unter „Mitteilungen“ ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose each event individually. System messages include errors and pause notices. “Fully indexed” appears only if the scan took longer than 59 seconds (including reconcile or re-index). If “Enable notifications” is off, events are disabled. macOS asks once at first launch; if denied, change it only in macOS System Settings › Notifications."
          }
        }
      }
    },
    "copy.settings.notices.text_lead" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Ereignis einzeln wählbar. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose each event individually. "
          }
        }
      }
    },
    "copy.settings.notices.text_tail" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " „Vollständig indiziert“ erscheint nur, wenn der Scan länger als 59 Sekunden gedauert hat (auch bei einem Abgleich oder „Neu indizieren“). Ist „Mitteilungen aktivieren“ aus, sind die Ereignisse deaktiviert. Beim ersten Start fragt macOS einmalig, ob Mitteilungen erlaubt werden. Wurde das abgelehnt, lässt es sich nur in den macOS-Systemeinstellungen unter „Mitteilungen“ ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " “Fully indexed” appears only if the scan took longer than 59 seconds (including reconcile or re-index). If “Enable notifications” is off, events are disabled. macOS asks once at first launch; if denied, change it only in macOS System Settings › Notifications."
          }
        }
      }
    },
